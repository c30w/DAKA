<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      提醒用得到的权限。

      POST_NOTIFICATIONS —— Android 13 起，发通知必须先动态申请，光在清单里声明没用。
      SCHEDULE_EXACT_ALARM —— 精确闹钟。Android 12 引入，14 起默认**不再授予**，
                              必须在设置页引导用户手动打开（代码里用 canScheduleExactAlarms 判断）。
      RECEIVE_BOOT_COMPLETED —— 监听开机，用来在重启后把被系统清空的闹钟重新排上。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      V3：接入系统日历（安卓日历 / 谷歌日历 / 厂商日历）用得到的两个权限。

      READ_CALENDAR  —— 读日程，显示在 DAKA 的日历视图里。
      WRITE_CALENDAR —— 把习惯提醒写进系统日历（带 RRULE），日历 App 里也能看到和提醒。

      两个都是危险权限，必须运行时动态申请，光写在清单里系统不会给。
      ⚠️ 少了它们，ContentResolver 会直接抛 SecurityException（不是返回空数据），
      所以代码里每个入口都先查权限再查数据（见 CalendarRepository）。

      ⚠️ 注意：小米 / 华为等 ROM 上，即便授予了权限，日历数据也可能被「日历应用」
      的隐私设置二次拦截。真机上如果读不到日程，先检查系统日历 App 里的数据是否正常。
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- 检查更新：拉 GitHub Release 接口需要联网（本应用无后端，版本发布在 GitHub） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DakaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DAKA">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DAKA"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              桌面长按图标的快捷方式（新建习惯 / 查看统计 / 一键打卡）。

              ⚠️ meta-data 必须挂在**启动 Activity** 上，挂在 <application> 里不生效——
              系统会去找声明了 MAIN + LAUNCHER 的那个 Activity 身上有没有这个 meta-data。

              ⚠️ 配套改了 android:launchMode="singleTask"：
              默认（standard）模式下，App 已在后台时点快捷方式会**再开一个 MainActivity**
              压在原来的上面；onNewIntent 不触发，Compose 这边也就收不到新的 action。
              改成 singleTask 后，复用已有实例、走 onNewIntent，快捷方式才能每次都生效。
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          闹钟到点的接收器。
          android:exported="false"：只接收本 App 自己发的广播，不让外部 App 触发。
          这是 Android 12 起的强制要求——不显式声明会直接安装失败。
        -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!--
          开机广播接收器。
          exported="true" 是必须的：这条广播由**系统**发出，属于外部来源。
        -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>